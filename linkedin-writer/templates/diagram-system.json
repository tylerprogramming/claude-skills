   "name": "diagram",
   "html": "<div class=\"toprule\"></div>\n<div class=\"hdr\"><div>tylerreedai</div><div>{{KICKER}}</div></div>\n<div class=\"ttl\">{{PRODUCT}}</div>\n<div class=\"flow\">\n  <div class=\"col\"><div class=\"lbl\">WHAT IT READS</div><div class=\"bx\"><div class=\"bt\">Your folder</div><div class=\"bs\">contracts, invoices, receipts, CSVs</div></div><div class=\"bx\"><div class=\"bt\">Gmail, Notion, Slack</div><div class=\"bs\">connected accounts</div></div><div class=\"bx\"><div class=\"bt\">Claude in Chrome</div><div class=\"bs\">reads sites like YouTube Studio</div></div></div>\n  <div class=\"ar\">&#8594;</div>\n  <div class=\"col ctr\">\n    <div class=\"lbl ac\">THE WHOLE TRICK</div>\n    <div class=\"hub\">\n      <div class=\"ht\">{{HUB_TITLE}}</div>\n      <div class=\"hs\">{{HUB_SUB}}</div>\n      <div class=\"chip\">{{HUB_CHIP}}</div>\n      <div class=\"hn\">{{HUB_NOTE}}</div>\n    </div>\n  </div>\n  <div class=\"ar\">&#8594;</div>\n  <div class=\"col\"><div class=\"lbl\">WHAT IT MAKES</div><div class=\"bx\"><div class=\"bt\">A folder that is actually organized</div><div class=\"bs\">messy client files, sorted</div></div><div class=\"bx\"><div class=\"bt\">An expense spreadsheet</div><div class=\"bs\">and it flags the duplicate subscription</div></div><div class=\"bx\"><div class=\"bt\">A weekly report</div><div class=\"bs\">from your own data, with recommendations</div></div><div class=\"bx\"><div class=\"bt\">A triaged inbox</div><div class=\"bs\">drafts already written in your voice</div></div></div>\n</div>\n<div class=\"band\"><span class=\"bl\">RUNS</span>\n  <span class=\"pill\">on demand</span><span class=\"pill\">saved as a skill</span>\n  <span class=\"pill hi\">on a schedule, while you sleep</span></div>\n<div class=\"ftr\"><div class=\"l\">{{FOOTER_LINE}}</div>\n<div class=\"r\">@tylerreedai</div></div>",
   "extra": "\n.ttl{padding:6px 40px 0;font-size:50px;font-weight:800;letter-spacing:-2px}\n.flow{flex:1;display:flex;align-items:stretch;gap:14px;padding:14px 40px 6px}\n.col{display:flex;flex-direction:column;gap:9px;flex:1;justify-content:space-between}\n.col .bx{flex:0 0 auto}\n.col.ctr{flex:0 0 300px}\n.lbl{font-family:\"SF Mono\",Menlo,monospace;font-size:14px;color:#8A8A92;letter-spacing:2px;margin-bottom:4px}\n.lbl.ac{color:#E07355}\n.bx{background:#1D1D24;border-radius:10px;padding:15px 16px}\n.bt{font-size:19px;font-weight:700;line-height:1.15}\n.bs{font-size:14px;color:#8A8A92;margin-top:3px;line-height:1.25}\n.ar{color:#E07355;opacity:.55;font-size:40px;flex-shrink:0;align-self:center}\n.hub{background:#201613;border:2px solid #E07355;border-radius:13px;padding:22px;text-align:center;flex:1;display:flex;flex-direction:column;justify-content:center}\n.ht{font-size:31px;font-weight:800;line-height:1.1;letter-spacing:-1px}\n.hs{font-size:20px;color:#E07355;font-weight:650;margin-top:5px}\n.chip{display:inline-block;background:#E07355;color:#111;font-family:\"SF Mono\",Menlo,monospace;\n      font-size:19px;font-weight:700;border-radius:6px;padding:6px 14px;margin-top:14px}\n.hn{font-size:14px;color:#8A8A92;margin-top:13px}\n.band{margin:0 40px;background:#1D1D24;border-radius:11px;padding:13px 18px;\n      display:flex;align-items:center;gap:11px}\n.bl{font-family:\"SF Mono\",Menlo,monospace;font-size:14px;color:#8A8A92;letter-spacing:2px;margin-right:4px}\n.pill{background:#2A2A33;border-radius:20px;padding:7px 16px;font-size:17px;font-weight:600}\n.pill.hi{background:#E07355;color:#111}\n.ftr{padding:20px 40px 26px}\n"
